# hiivmind-pulse-gh - Repository Settings Configuration
# This file contains settings and protection rules for a specific repository.
# Each repo gets its own file: .hiivmind/github/repos/{repo-name}.yaml
#
# Generated by hiivmind-pulse-gh-refresh on {{synced_at}}

# Repository identification
repository:
  name: {{repo_name}}              # Repository name
  id: {{repo_id}}                  # GraphQL node ID (R_kgDO...)
  full_name: {{owner}}/{{repo_name}}  # Full repository path
  default_branch: {{default_branch}}  # Default branch name (e.g., main)
  visibility: {{visibility}}       # public, private, internal
  archived: {{archived}}           # true if archived

# Branch protection rules (legacy API)
# Per-branch protection settings
branch_protection:
  {{branch_name}}:                 # e.g., main, develop
    enabled: {{enabled}}           # true if protection is enabled

    # Pull request requirements
    required_pull_request_reviews:
      required_approving_review_count: {{count}}  # Number of approvals needed
      dismiss_stale_reviews: {{bool}}             # Dismiss on new commits
      require_code_owner_reviews: {{bool}}        # Require code owner approval
      require_last_push_approval: {{bool}}        # Require approval after last push

    # Status check requirements
    required_status_checks:
      strict: {{bool}}               # Require branches to be up to date
      contexts: {{contexts}}         # List of required check names

    # Additional protections
    enforce_admins: {{bool}}         # Apply rules to admins
    required_linear_history: {{bool}}  # Require linear history
    allow_force_pushes: {{bool}}     # Allow force pushes
    allow_deletions: {{bool}}        # Allow branch deletion
    required_conversation_resolution: {{bool}}  # Require conversation resolution
    lock_branch: {{bool}}            # Lock branch (read-only)
    allow_fork_syncing: {{bool}}     # Allow fork syncing

    # Restrictions (who can push)
    restrictions:
      users: {{users}}               # List of user logins
      teams: {{teams}}               # List of team slugs
      apps: {{apps}}                 # List of app slugs

# Repository rulesets (modern API)
# Pattern-based protection rules
rulesets:
  - id: {{ruleset_id}}
    name: {{ruleset_name}}
    target: {{target}}               # branch, tag
    enforcement: {{enforcement}}     # active, evaluate, disabled

    # Conditions (when this ruleset applies)
    conditions:
      ref_name:
        include: {{include_patterns}}  # e.g., ["refs/heads/main"]
        exclude: {{exclude_patterns}}  # e.g., ["refs/heads/release/*"]

    # Rules to enforce
    rules:
      - type: {{rule_type}}          # pull_request, required_signatures, etc.
        parameters: {{parameters}}   # Rule-specific parameters

# Merge settings
merge_settings:
  allow_merge_commit: {{bool}}       # Allow merge commits
  allow_squash_merge: {{bool}}       # Allow squash merging
  allow_rebase_merge: {{bool}}       # Allow rebase merging
  allow_auto_merge: {{bool}}         # Allow auto-merge
  delete_branch_on_merge: {{bool}}   # Auto-delete head branches
  allow_update_branch: {{bool}}      # Allow updating PR branches
  squash_merge_commit_title: {{title_option}}      # PR_TITLE, COMMIT_OR_PR_TITLE
  squash_merge_commit_message: {{message_option}}  # PR_BODY, COMMIT_MESSAGES, BLANK
  merge_commit_title: {{title_option}}             # PR_TITLE, MERGE_MESSAGE
  merge_commit_message: {{message_option}}         # PR_BODY, PR_TITLE, BLANK

# Repository labels
labels:
  - name: {{label_name}}             # Label name
    color: {{hex_color}}             # Hex color without #
    description: {{description}}     # Label description (optional)
    default: {{bool}}                # true if default label

# Metadata
cache:
  synced_at: {{synced_at}}           # ISO timestamp of last fetch
  schema_version: "1.0"
