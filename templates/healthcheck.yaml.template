# hiivmind-pulse-gh healthcheck state
# Created: {{initialized_at}}
# Tracks governance audit results and team dismissal decisions
# Committed to git — dismissals are team-shared governance decisions

version: "1.0"

last_run:
  timestamp: null
  scope: all           # "all" or specific repo name
  aggregate_score: 0
  aggregate_total: 11
  aggregate_grade: null

repos:
