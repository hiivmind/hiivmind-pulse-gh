dismissals:
  # Per-repo dismissals keyed by repo name
  # Team governance decisions — committed to git
  #
  # Example:
  # hiivmind-pulse-gh:
  #   releases:
  #     dismissed_at: "2026-02-21T10:00:00Z"
  #     dismissed_by: alice
  #     reason: "Pre-release project, no formal releases yet"
  #     review_after: "2026-05-21"    # null for permanent dismissal
