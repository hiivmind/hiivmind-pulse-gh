# hiivmind-pulse-gh healthcheck state
# Created: {{initialized_at}}
# Tracks governance audit results and team dismissal decisions
# Committed to git — dismissals are team-shared governance decisions

version: "1.0"

last_run:
  run_at: null
  by_scorecard: {}
  coverage:
    checks_total: 0
    checks_supported: 0
    unsupported_by_adapter: {}
    unprofiled_repos: []

repos:
  # Per-repo results keyed by repo name
  # Populated on first healthcheck run
  #
  # Example:
  # hiivmind-pulse-gh:
  #   scorecard: python-library-v1
  #   score: 8
  #   total: 10
  #   grade: B
  #   coverage_supported: 10
  #   coverage_total: 10
  #   checks:
  #     documentation:
  #       check_id: documentation
  #       profile: python-library
  #       adapter: generic.docs
  #       weight: 2
  #       status: pass
  #       last_evaluated: "2026-02-21T14:30:00Z"
  #       detail: "README and docs present"
  #       data: {evidence: {paths: [README.md, docs/], refs: []}}

dismissals:
  # Per-repo dismissals keyed by repo name
  # Team governance decisions — committed to git
  #
  # Example:
  # hiivmind-pulse-gh:
  #   releases:
  #     dismissed_at: "2026-02-21T10:00:00Z"
  #     dismissed_by: alice
  #     reason: "Pre-release project, no formal releases yet"
  #     review_after: "2026-05-21"    # null for permanent dismissal
  #   codeowners:
  #     dismissed_at: "2026-02-21T10:00:00Z"
  #     dismissed_by: alice
  #     reason: "Small team, all members are owners"
  #     review_after: null
