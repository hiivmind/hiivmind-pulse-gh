# hiivmind-pulse-gh - Project Views Configuration
# This file contains view configurations for a specific GitHub Project v2.
# Each project gets its own file: .hiivmind/github/views/project-{N}.yaml
#
# Generated by hiivmind-pulse-gh-refresh on {{synced_at}}

# Project identification
project:
  number: {{project_number}}       # Project number (visible in URL)
  id: {{project_id}}               # GraphQL node ID (PVT_...)
  title: {{project_title}}         # Project title

# View configurations
# Each view represents a different layout/filter of the project board
views:
  - number: {{view_number}}        # View number (1-based index)
    id: {{view_id}}                # GraphQL node ID
    name: {{view_name}}            # View name (e.g., "Backlog", "Current Sprint")
    layout: {{layout}}             # BOARD_LAYOUT, TABLE_LAYOUT, ROADMAP_LAYOUT
    filter: {{filter}}             # View filter expression (e.g., "status:open")

    # Fields visible in this view
    visible_fields:
      - Title                      # Always visible
      - Status
      - Priority
      - Assignees

    # Fields hidden in this view (derived from all fields - visible fields)
    hidden_fields:
      - Estimate
      - "Start date"
      - "End date"

    # Group by configuration
    group_by:
      - field: Status              # Field to group by
        direction: ASC             # Optional: ASC or DESC

    # Sort by configuration
    sort_by:
      - field: Priority            # Field to sort by
        direction: ASC             # ASC or DESC
      - field: Title               # Secondary sort
        direction: ASC

# Metadata
cache:
  synced_at: {{synced_at}}         # ISO timestamp of last fetch
  schema_version: "1.0"
