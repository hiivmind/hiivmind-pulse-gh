# Metadata
cache:
  synced_at: {{synced_at}}         # ISO timestamp of last update
  schema_version: "1.0"
  source: "manual"                 # "manual" or "api" (when API support improves)

# Notes:
# - GitHub Projects v2 automations are currently UI-only
# - This file serves as documentation for automation-aware operations
# - Update this file manually when you change automations in the project UI
# - Future API improvements may allow automated detection
