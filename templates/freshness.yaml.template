# hiivmind-pulse-gh - Per-Section Freshness Tracking
# This file tracks when each config section was last synced with GitHub.
# Different sections have different update frequencies, so we track them independently.
#
# Generated by gh-init on {{initialized_at}}
# Updated by gh-refresh on each sync

# Default threshold for sections not explicitly configured
defaults:
  threshold_hours: 168  # 7 days

# Per-section freshness tracking
sections:
  # Core workspace metadata (organization/user info)
  # Rarely changes - only when renaming org or switching workspace
  workspace:
    threshold_hours: 720  # 30 days
    last_checked: null
    stale: true
    note: "Organization/user metadata"

  # Project metadata (titles, IDs, field definitions)
  # Changes when fields are added/removed or options renamed
  projects:
    threshold_hours: 168  # 7 days
    last_checked: null
    stale: true
    projects_covered: []
    note: "Project fields and options"

  # Project views (layouts, filters, visible fields)
  # Frequently updated as team adjusts board views
  views:
    threshold_hours: 24  # 1 day
    last_checked: null
    stale: true
    projects_covered: []
    note: "Project view configurations (Phase 2)"

  # Project automations (auto-add, auto-set, auto-archive)
  # Moderate change rate as workflows are refined
  automations:
    threshold_hours: 72  # 3 days
    last_checked: null
    stale: true
    projects_covered: []
    note: "Project automation rules (Phase 4)"

  # Repository list and basic metadata
  # Changes when new repos are added to workspace
  repositories:
    threshold_hours: 168  # 7 days
    last_checked: null
    stale: true
    repos_covered: []
    note: "Repository catalog"

  # Repository settings (protection, merge settings, labels)
  # Changes when protection rules or labels are modified
  repo_settings:
    threshold_hours: 72  # 3 days
    last_checked: null
    stale: true
    repos_covered: []
    note: "Branch protection, merge settings, labels (Phase 3)"

  # Cross-repo relationships (project links, dependencies)
  # Changes with project-repo links and dependency declarations
  relationships:
    threshold_hours: 168  # 7 days
    last_checked: null
    stale: true
    note: "Project-repo links and dependencies (Phase 5)"

  # Team membership and permissions
  # Changes when team members are added/removed
  teams:
    threshold_hours: 168  # 7 days
    last_checked: null
    stale: true
    note: "Team rosters and permissions (Phase 6)"

# Metadata
cache:
  created_at: null
  last_updated_at: null
  version: "1.0"
