{
  "description": "Safety hooks for GitHub operations - blocks dangerous commands at execution time",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/validate-gh-operation.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
